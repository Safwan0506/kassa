# =============================================================================
# Kassa -- Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# =============================================================================

# --- Base de donnees PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kassa
DB_USER=kassa
DB_PASSWORD=changez_moi_en_production

# --- JWT / Authentification ---
# Secret pour signer les tokens (minimum 256 bits, generer avec: openssl rand -base64 32)
JWT_SECRET=changez_moi_secret_jwt_256bits
# Duree de vie du token d'acces (ex: 15m, 1h)
JWT_EXPIRY=15m
# Duree de vie du refresh token (ex: 7d, 30d)
REFRESH_EXPIRY=7d

# --- SMTP / Emails ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=changez_moi_smtp
SMTP_FROM=Kassa <noreply@example.com>

# --- CORS ---
# Origines autorisees (separees par des virgules)
CORS_ORIGINS=https://votre-domaine.com

# --- Application ---
APP_PORT=8080
APP_ENV=production
