{
	# En developpement, desactiver HTTPS automatique
	# Retirer ce bloc en production
	auto_https off
}

:80 {
	# Headers de securite
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-XSS-Protection "0"
		-Server
	}

	# API : proxy vers le backend Spring Boot
	handle /api/* {
		reverse_proxy api:8080
	}

	# Frontend : proxy vers nginx
	handle {
		reverse_proxy web:80
	}

	log {
		output stdout
		format console
	}
}
